# FrameItUp — Variables d'environnement
# Copier ce fichier en .env.local dans chaque app concernée

# ─── Convex ───────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ─── Authentification (Convex Auth) ───────────────────────────────────────────
CONVEX_AUTH_SECRET=your-auth-secret-here
JWT_PRIVATE_KEY=your-jwt-private-key

# ─── Google Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── API GraphQL ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GRAPHQL_URL=https://your-deployment.convex.site/graphql

# ─── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_SECRET=your-dashboard-secret
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3001
